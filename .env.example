# 이 파일을 복사해서 ".env" 로 이름을 바꾸고, 실제 키를 넣으세요.
# .env 는 .gitignore 에 등록되어 있어 GitHub에 올라가지 않습니다.
ANTHROPIC_API_KEY=여기에_Anthropic_키
GEMINI_API_KEY=여기에_Gemini_키
OPENAI_API_KEY=여기에_OpenAI_키

# (선택) Gemini 모델을 바꾸고 싶을 때만 앞의 # 을 지우고 수정
# GEMINI_MODEL=gemini-3.8-flash
# (선택) OpenAI 이미지 모델을 바꾸고 싶을 때만
# OPENAI_IMAGE_MODEL=gpt-image-2

# 첫 전체 관리자 계정 (python ssg.py init 또는 user seed 때 한 번 만들어짐. 비밀번호는 암호화해서 저장)
ADMIN_EMAIL=관리자_이메일
ADMIN_PASSWORD=8자_이상_비밀번호
